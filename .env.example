# Configuration pour le déploiement de l'application CTF
# Copiez ce fichier vers .env et remplissez vos clés API

# Clé API Gemini (obligatoire pour l'IA)
GEMINI_API_KEY=votre_cle_gemini_ici

# Clé API OpenAI (obligatoire pour la synthèse vocale)
OPENAI_API_KEY=votre_cle_openai_ici

# Mot de passe admin (obligatoire pour accéder au panneau admin)
ADMIN_PASSWORD=change_me_to_a_long_random_password

# Configuration base de données (optionnel)
DATABASE_PATH=/app/data/conversations.db
